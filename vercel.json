{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/shuttle",
      "destination": "/zenbus-shuttle-prototype"
    },
    {
      "source": "/waste",
      "destination": "/zenduwork-waste-prototype"
    },
    {
      "source": "/waste-simulation",
      "destination": "/zenduwork-waste-simulation"
    },
    {
      "source": "/airport",
      "destination": "/zenduone-airport-prototype"
    },
    {
      "source": "/driver-safety",
      "destination": "/zenduone-driver-safety-prototype"
    },
    {
      "source": "/live-map",
      "destination": "/zenduone-live-map-prototype"
    },
    {
      "source": "/fleet-safety",
      "destination": "/zenduone-fleet-safety-prototype"
    },
    {
      "source": "/maintenance",
      "destination": "/zenduone-maintenance-prototype"
    },
    {
      "source": "/deck/school-bus",
      "destination": "/seller-deck-school-bus"
    },
    {
      "source": "/deck/shuttle",
      "destination": "/seller-deck-shuttle"
    },
    {
      "source": "/deck/waste",
      "destination": "/seller-deck-waste"
    },
    {
      "source": "/brochure/zenbus",
      "destination": "/brochure-zenbus"
    },
    {
      "source": "/brochure/waste",
      "destination": "/seller-brochure-waste"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/deck/school-shuttle",
      "destination": "/deck/school-bus",
      "permanent": false
    },
    {
      "source": "/seller-deck-school-shuttle",
      "destination": "/deck/school-bus",
      "permanent": false
    }
  ]
}