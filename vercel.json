{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/shuttle",
      "destination": "/zenbus-shuttle-prototype"
    },
    {
      "source": "/waste",
      "destination": "/zenduwork-waste-prototype"
    },
    {
      "source": "/waste-simulation",
      "destination": "/zenduwork-waste-simulation"
    },
    {
      "source": "/airport",
      "destination": "/zenduone-airport-prototype"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}